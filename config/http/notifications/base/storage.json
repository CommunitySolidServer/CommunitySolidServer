{
  "@context": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
  "@graph": [
    {
      "comment": "Storage to be used to keep track of subscriptions.",
      "@id": "urn:solid-server:default:SubscriptionStorage",
      "@type": "KeyValueChannelStorage",
      "locker": { "@id": "urn:solid-server:default:ResourceLocker" },
      "storage": {
        "comment": [
          "Uses its own container so the expiry sweep only has to list notification channels.",
          "The key length limit accounts for the `notifications/` prefix that used to be part of the key,",
          "so existing channels keep their paths."
        ],
        "@type": "MaxKeyLengthStorage",
        "maxKeyLength": 136,
        "source": {
          "@type": "JsonResourceStorage",
          "source": { "@id": "urn:solid-server:default:ResourceStore" },
          "baseUrl": { "@id": "urn:solid-server:default:variable:baseUrl" },
          "container": "/.internal/notifications/"
        }
      }
    },
    {
      "comment": "Stops notification channel sweeps and waits for pending storage operations before backend cleanup.",
      "@id": "urn:solid-server:default:Finalizer",
      "@type": "ParallelHandler",
      "handlers": [
        {
          "@type": "FinalizableHandler",
          "finalizable": { "@id": "urn:solid-server:default:SubscriptionStorage" }
        }
      ]
    }
  ]
}
